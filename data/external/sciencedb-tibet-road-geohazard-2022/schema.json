{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/external_disaster_event.v1.json",
  "title": "AEGIS 外部灾情记录（统一信封）v1",
  "description": "data/external 全部数据集的 normalized 唯一形状：七个固定信封字段；数据集特有列进 hazard.attributes 或 source。空值一律 null（未报），不用 0 冒充。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source",
    "event",
    "geo",
    "hazard",
    "impact"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "dataset",
        "license"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "date_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_accuracy": {
          "type": [
            "string",
            "null"
          ]
        },
        "storm_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_start": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "date_end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        }
      }
    },
    "geo": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "country",
        "admin_division"
      ],
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin_division": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hazard": {
      "type": "object",
      "required": [
        "type",
        "source_category",
        "attributes"
      ],
      "properties": {
        "type": {
          "enum": [
            "landslide",
            "rockfall",
            "debris_flow",
            "avalanche",
            "lake_outburst",
            "quake_triggered",
            "unknown"
          ]
        },
        "source_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "fatalities",
        "injuries"
      ],
      "properties": {
        "fatalities": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "injuries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
