{
  "schema_version": "1.0.0",
  "format": "csv",
  "encoding": "utf-8",
  "line_endings": "LF",
  "primary_key": "record_id",
  "columns": [
    {"name": "record_id", "type": "string", "required": true, "pattern": "^sciencedb-tibet-road-geohazard-2022:[A-Za-z0-9]+$"},
    {"name": "source_category", "type": "enum", "required": true, "values": ["崩塌", "水毁", "沉陷塌陷", "泥石流", "滑坡"]},
    {"name": "hazard_type", "type": "enum", "required": true, "values": ["landslide", "rockfall", "debris_flow", "avalanche", "lake_outburst", "quake_triggered", "unknown"]},
    {"name": "disaster_code", "type": "string", "required": true, "note": "源数据灾害编号，全表唯一"},
    {"name": "name", "type": "string", "required": false},
    {"name": "road_class", "type": "string", "required": false},
    {"name": "road_name", "type": "string", "required": false},
    {"name": "road_code", "type": "string", "required": false},
    {"name": "admin_code", "type": "string", "required": false, "pattern": "^([0-9]{6})?$"},
    {"name": "maintainer", "type": "string", "required": false},
    {"name": "occurred", "type": "enum", "required": false, "values": ["true", "false", ""], "note": "源字段『是否发生灾害』；false 是隐患点，不是已发生事件"},
    {"name": "last_event_date", "type": "string", "required": false, "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
    {"name": "last_event_date_raw", "type": "string", "required": false},
    {"name": "blocked_status", "type": "string", "required": false},
    {"name": "severity", "type": "string", "required": false},
    {"name": "damage_level", "type": "string", "required": false},
    {"name": "development_degree", "type": "string", "required": false},
    {"name": "tech_level", "type": "string", "required": false},
    {"name": "occurrence_window_years", "type": "enum", "required": true, "values": ["5", "10"]},
    {"name": "occurrence_count", "type": "string", "required": false},
    {"name": "treatment", "type": "string", "required": false},
    {"name": "check_status", "type": "string", "required": false},
    {"name": "start_stake", "type": "string", "required": false},
    {"name": "end_stake", "type": "string", "required": false},
    {"name": "longitude", "type": "number", "required": true, "minimum": 78, "maximum": 100},
    {"name": "latitude", "type": "number", "required": true, "minimum": 26, "maximum": 37},
    {"name": "geometry_points", "type": "integer", "required": true, "minimum": 1}
  ]
}
