{
  "name": "aegis-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIS 山地灾害多智能体协同调控平台 — Web 前端（纯 Web，无原生移动端）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:workflow": "eslint \"src/utils/graph/**/*.{ts,vue}\" \"src/composables/workflow/**/*.{ts,vue}\" \"src/stores/workflow/**/*.{ts,vue}\" \"src/api/workflow/**/*.{ts,vue}\" \"src/components/workflow/**/*.{ts,vue}\" \"src/views/WorkflowView.vue\" --no-error-on-unmatched-pattern",
    "format:check:workflow": "prettier --check \"src/utils/graph/**/*.{ts,vue}\" \"src/composables/workflow/**/*.{ts,vue}\" \"src/stores/workflow/**/*.{ts,vue}\" \"src/api/workflow/**/*.{ts,vue}\" \"src/components/workflow/**/*.{ts,vue}\" \"src/views/WorkflowView.vue\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "prepare:cesium": "node scripts/prepare-cesium.mjs",
    "predev": "npm run prepare:cesium",
    "prebuild": "npm run prepare:cesium"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^15.0.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "cesium": "^1.145.0",
    "echarts": "^5.5.1",
    "pinia": "^4.0.3",
    "pmtiles": "^4.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
