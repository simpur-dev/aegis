# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 环境与凭据：任何 .env 均不入库（模板见 .env.example）
.env
.env.*
!.env.example
*.pem
*.key

# 运行态数据
backend/data/
data/
# 例外：内置预案案例库随包发布（源码目录里的 data/，不是运行态数据）。
# `data/` 会匹配任意层级的同名目录，命中的是"整个目录不进仓库"，所以必须先放行目录再放行文件；
# 漏了这一条，新克隆就没有降级可兜底的案例，而本地测试因为文件在盘上照样全绿。
!backend/src/aegis/knowledge/data/
!backend/src/aegis/knowledge/data/hazard_cases.json
# 例外：演示用区域画像随仓库发布（导入命令的验收路径指向 backend/data/）。
# 目录放行后只再放行这一份文件，其余内容（models 等运行态数据）仍然不入库。
!backend/data/
backend/data/*
!backend/data/site_profiles.demo.jsonl
# 例外：外部公开灾情数据随仓库发布（NASA GLC，公共领域，可再分发；来源/许可/校验和见
# data/external/README.md）。锚定仓库根，避免把任意层级的 data/ 一并放行；运行态数据仍不入库。
!/data/
/data/*
!/data/external/
!/data/external/**
*.db
*.sqlite3
logs/
*.log
uploads/

# Node / 前端
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 生成产物
backend/reports/
# 钉在仓库根：原来写成 `reports/` 会顺手把源码目录
# `frontend/src/components/reports/`（批次 B5 的上报表单）也忽略掉——同名不等于同用途。
/reports/

# Cesium 静态资源由 npm run prepare:cesium 从 node_modules 落盘，属依赖产物
frontend/public/cesium/

# Playwright 视觉烟雾门禁的输出（截图、失败现场）；浏览器本体检在 ~/.cache/ms-playwright
frontend/test-results/
frontend/playwright-report/
frontend/playwright-install.log


# 浏览器巡检的现场留档（截图、临时探针脚本）：只在本地用作证据，不入库
frontend/.tmp-verify/
backend/.tmp-verify/

# 根目录下的临时证据目录（曾用来放 482MB 的 nats 状态拷贝）：临时产物一律不入库
/.tmp-verify/

# 本地部署/巡检留档（容器日志、页面截图、一次性 CDP 探针脚本）：只在本地当证据，不入库
.deploy-logs/

# 归档区：只作溯源，不进主线构建（不进 wheel/镜像/门禁扫描）
/archive/external_agents_source_20261109/*.zip

# 外部智能体模块的运行时产物（反馈记忆 JSON）：由环境变量指定路径，不进代码仓
backend/src/aegis/agents/hazards/feedback_agent/memory/

# 本地临时产物（不入仓）
/.workbuddy/
/frontend/dist.stale/
/.zcode/
