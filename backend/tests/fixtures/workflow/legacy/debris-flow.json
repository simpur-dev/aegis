{
  "workflow_id": "wf_67ea7014e326",
  "name": "泥石流预警标准流程",
  "description": "雨强与泥位双条件触发 → 定级 → 生成预警 → 指挥员核签 → 多通道发布 → 回执采集",
  "version": 1,
  "nodes": [
    {
      "node_id": "fetch_rain",
      "type": "data_fetch",
      "name": "拉取区域读数",
      "config": {
        "limit": 500
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "check_trigger",
      "type": "threshold",
      "name": "触发条件判定",
      "config": {
        "upstream": "fetch_rain",
        "mode": "all",
        "conditions": [
          {
            "metric": "rain_10min",
            "op": ">=",
            "threshold": 30.0,
            "agg": "max"
          },
          {
            "metric": "debris_level",
            "op": ">=",
            "threshold": 1.0,
            "agg": "max"
          }
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "assess",
      "type": "risk_assess",
      "name": "风险定级",
      "config": {
        "upstream": "check_trigger"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "generate",
      "type": "warning_generate",
      "name": "生成预警",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "commander_sign",
      "type": "human_review",
      "name": "指挥员核签",
      "config": {
        "prompt": "请确认是否发布该预警",
        "options": [
          "approve",
          "reject"
        ]
      },
      "sla_ms": 60000,
      "timeout_ms": 60000,
      "on_failure": "escalate",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "publish",
      "type": "warning_publish",
      "name": "靶向发布",
      "config": {
        "channels": [
          "sms",
          "broadcast",
          "wechat"
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "feedback",
      "type": "feedback_collect",
      "name": "触达回执",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "log_quiet",
      "type": "notify",
      "name": "未触发记录",
      "config": {
        "text": "本轮未触发泥石流预警",
        "level": "debug"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    }
  ],
  "edges": [
    {
      "source": "fetch_rain",
      "target": "check_trigger",
      "condition": ""
    },
    {
      "source": "check_trigger",
      "target": "assess",
      "condition": "triggered"
    },
    {
      "source": "check_trigger",
      "target": "log_quiet",
      "condition": "not_triggered"
    },
    {
      "source": "assess",
      "target": "generate",
      "condition": ""
    },
    {
      "source": "generate",
      "target": "commander_sign",
      "condition": ""
    },
    {
      "source": "commander_sign",
      "target": "publish",
      "condition": "approve"
    },
    {
      "source": "publish",
      "target": "feedback",
      "condition": ""
    }
  ],
  "created_by": "platform.workflow",
  "status": "active"
}
