{
  "workflow_id": "wf_fc5abaf12dcc",
  "name": "雪崩气象型预警与交通管控流程",
  "description": "新雪叠加强风走定级发布链，气温骤升叠加雪水当量走弱层加密观测支路；高风险先调取公路雪况实况（占位地址，需白名单）",
  "version": 1,
  "nodes": [
    {
      "node_id": "fetch_snow",
      "type": "data_fetch",
      "name": "拉取积雪气象读数",
      "config": {
        "limit": 400
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "check_snow_load",
      "type": "threshold",
      "name": "新雪叠加强风吹雪判定",
      "config": {
        "upstream": "fetch_snow",
        "mode": "all",
        "conditions": [
          {
            "metric": "new_snow_cm",
            "op": ">=",
            "threshold": 25.0,
            "agg": "max"
          },
          {
            "metric": "wind_speed_ms",
            "op": ">=",
            "threshold": 14.0,
            "agg": "max"
          }
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "check_weak_layer",
      "type": "threshold",
      "name": "气温骤升弱层失稳判定",
      "config": {
        "upstream": "fetch_snow",
        "mode": "all",
        "conditions": [
          {
            "metric": "air_temperature_c",
            "op": ">=",
            "threshold": 2.0,
            "agg": "max"
          },
          {
            "metric": "snow_water_equivalent_mm",
            "op": ">=",
            "threshold": 40.0,
            "agg": "max"
          }
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "assess",
      "type": "risk_assess",
      "name": "风险定级",
      "config": {
        "upstream": "check_snow_load"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "route",
      "type": "branch",
      "name": "按等级决定是否先调取雪况实况",
      "config": {
        "upstream": "assess",
        "rules": [
          {
            "when": "risk_level",
            "op": "<=",
            "value": 2,
            "then": "traffic_check"
          }
        ],
        "default": "publish_direct"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "traffic_intel",
      "type": "api_call",
      "name": "调取公路雪况实况（占位地址，需现场替换）",
      "config": {
        "method": "GET",
        "url": "https://api.example.com/snow-intel"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "degrade",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "generate",
      "type": "warning_generate",
      "name": "生成预警",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "publish",
      "type": "warning_publish",
      "name": "靶向发布",
      "config": {
        "channels": [
          "sms",
          "broadcast"
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "feedback",
      "type": "feedback_collect",
      "name": "触达回执",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "pit_watch",
      "type": "notify",
      "name": "弱层失稳转雪坑观测",
      "config": {
        "text": "气温回升叠加强融雪，雪层弱层失稳，转雪坑与人工加密观测",
        "level": "warning"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "log_quiet",
      "type": "notify",
      "name": "未触发记录",
      "config": {
        "text": "本轮未触发雪崩荷载阈值",
        "level": "debug"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    }
  ],
  "edges": [
    {
      "source": "fetch_snow",
      "target": "check_snow_load",
      "condition": ""
    },
    {
      "source": "fetch_snow",
      "target": "check_weak_layer",
      "condition": ""
    },
    {
      "source": "check_snow_load",
      "target": "assess",
      "condition": "triggered"
    },
    {
      "source": "check_snow_load",
      "target": "log_quiet",
      "condition": "not_triggered"
    },
    {
      "source": "check_weak_layer",
      "target": "pit_watch",
      "condition": "triggered"
    },
    {
      "source": "assess",
      "target": "route",
      "condition": ""
    },
    {
      "source": "route",
      "target": "traffic_intel",
      "condition": "traffic_check"
    },
    {
      "source": "route",
      "target": "generate",
      "condition": "publish_direct"
    },
    {
      "source": "traffic_intel",
      "target": "generate",
      "condition": ""
    },
    {
      "source": "generate",
      "target": "publish",
      "condition": ""
    },
    {
      "source": "publish",
      "target": "feedback",
      "condition": ""
    }
  ],
  "created_by": "platform.workflow",
  "status": "active"
}
