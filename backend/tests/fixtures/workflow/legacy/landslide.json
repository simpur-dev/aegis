{
  "workflow_id": "wf_61cc9f07b967",
  "name": "滑坡隐患点降雨-位移双判处置流程",
  "description": "降雨入渗叠加位移 → 灾种识别 → 定级 → 案例态势推演 → 指挥员核签 → 生成并发布 → 回执；未触发转人工加密巡查",
  "version": 1,
  "nodes": [
    {
      "node_id": "fetch_watch",
      "type": "data_fetch",
      "name": "拉取隐患点读数",
      "config": {
        "limit": 500
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "check_infiltration",
      "type": "threshold",
      "name": "降雨入渗叠加位移判定",
      "config": {
        "upstream": "fetch_watch",
        "mode": "all",
        "conditions": [
          {
            "metric": "rain_cumulative_24h",
            "op": ">=",
            "threshold": 60.0,
            "agg": "max"
          },
          {
            "metric": "displacement_mm",
            "op": ">=",
            "threshold": 20.0,
            "agg": "max"
          }
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "identify_hazard",
      "type": "hazard_identify",
      "name": "灾种识别",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "assess",
      "type": "risk_assess",
      "name": "风险定级",
      "config": {
        "upstream": [
          "check_infiltration",
          "identify_hazard"
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "simulate",
      "type": "situation_simulate",
      "name": "滑动态势推演",
      "config": {
        "extra": {
          "horizon_minutes": 120
        }
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "commander_sign",
      "type": "human_review",
      "name": "指挥员核签转移与预警",
      "config": {
        "prompt": "是否组织受威胁群众转移并签发滑坡预警",
        "options": [
          "approve",
          "reject"
        ]
      },
      "sla_ms": 60000,
      "timeout_ms": 60000,
      "on_failure": "escalate",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "generate",
      "type": "warning_generate",
      "name": "生成预警",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "publish",
      "type": "warning_publish",
      "name": "靶向发布",
      "config": {
        "channels": [
          "sms",
          "broadcast",
          "wechat"
        ]
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "feedback",
      "type": "feedback_collect",
      "name": "触达回执",
      "config": {},
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    },
    {
      "node_id": "patrol",
      "type": "notify",
      "name": "转人工巡查",
      "config": {
        "text": "本轮未触发滑坡阈值，转人工加密巡查",
        "level": "info"
      },
      "sla_ms": 5000,
      "timeout_ms": 5000,
      "on_failure": "retry",
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 200
      }
    }
  ],
  "edges": [
    {
      "source": "fetch_watch",
      "target": "check_infiltration",
      "condition": ""
    },
    {
      "source": "check_infiltration",
      "target": "identify_hazard",
      "condition": "triggered"
    },
    {
      "source": "check_infiltration",
      "target": "assess",
      "condition": "triggered"
    },
    {
      "source": "identify_hazard",
      "target": "assess",
      "condition": ""
    },
    {
      "source": "assess",
      "target": "simulate",
      "condition": ""
    },
    {
      "source": "simulate",
      "target": "commander_sign",
      "condition": ""
    },
    {
      "source": "commander_sign",
      "target": "generate",
      "condition": "approve"
    },
    {
      "source": "publish",
      "target": "feedback",
      "condition": ""
    },
    {
      "source": "generate",
      "target": "publish",
      "condition": ""
    },
    {
      "source": "check_infiltration",
      "target": "patrol",
      "condition": "not_triggered"
    }
  ],
  "created_by": "platform.workflow",
  "status": "active"
}
