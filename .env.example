# ===== LLM（OpenAI 兼容接口；留空则研判走规则引擎降级路径）=====
AEGIS_LLM_API_KEY=
AEGIS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AEGIS_LLM_MODEL=qwen-plus
AEGIS_LLM_TIMEOUT_SECONDS=20
# 网关 v2（§4.1 / D3）：provider 连续失败到该次数即熔断并切备用模型；用量台账环形上限。
AEGIS_LLM_BREAKER_FAIL_THRESHOLD=3
AEGIS_LLM_USAGE_LEDGER_LIMIT=10000
# 每个 agent_id 的月度 token 预算（§4.8.3）：超限只告警、不熔断；0=不控成本。
AEGIS_LLM_MONTHLY_TOKEN_BUDGET_DEFAULT=0

# ===== 安全 =====
# 数据 API 服务令牌（§4.8.1）：智能体经数据 API / MCP 工具取数共用。
# 空=不校验（默认，内部装配/演练/前端调用照常）；非空=读数据端点须带 X-Aegis-Token。
AEGIS_SERVICE_TOKEN=

# 智能体运行时（§3/§6 MA，与 mock 互斥）：real=真内环上总线（此时 mock 不启动）、mock=联调替身、off=都不起。
# 真模式缺 LLM 密钥/解析器等依赖时由内环自己降级留痕，装配点不塞替身。
AEGIS_AGENT_RUNTIME=mock
# 按 task 的多模型路由表（JSON 覆盖内置初值；未配的 task 继承上面的 AEGIS_LLM_MODEL）。
# 内置初值见 aegis.config._default_llm_routes，全部为未实测初值，联调后回填：
# AEGIS_LLM_MODELS={"assess":{"model":"qwen-max","fallback_model":"qwen-plus"},"execute":{"model":"qwen-plus","temperature":0.4}}

# ===== 运行环境 =====
AEGIS_ENV=dev
AEGIS_LOG_LEVEL=INFO
AEGIS_HTTP_HOST=0.0.0.0
AEGIS_HTTP_PORT=8000

# ===== 总线：memory（离线开发）| nats（生产）=====
AEGIS_BUS_BACKEND=memory
AEGIS_NATS_URL=nats://127.0.0.1:4222
AEGIS_NATS_STREAM_PREFIX=AEGIS
AEGIS_DEFAULT_REQUEST_DEADLINE_MS=10000
AEGIS_GATEWAY_ALLOW_UNREGISTERED_ACTION=false

# ===== 运行态存储面 =====
# memory：只有内存读视图（离线开发/演练）。postgres：在同一读视图前加 PostGIS/pgvector 落库。
AEGIS_STORE_BACKEND=memory
# PostgreSQL 连接串（asyncpg 口径；写 SQLAlchemy 的 +asyncpg 后缀也会被 persistence.dsn 收敛）。
# AEGIS_STORE_BACKEND=postgres 时必填，留空会在容器构造期显式失败而不是静默退回内存。
AEGIS_PG_DSN=
AEGIS_PG_POOL_MIN_SIZE=1
AEGIS_PG_POOL_MAX_SIZE=8
AEGIS_PG_APPLY_MIGRATIONS_ON_START=true

# ===== 案例知识层（Graphiti 时序图谱；留空则用内置案例的内存提供者）=====
AEGIS_KNOWLEDGE_GRAPHITI_URI=
AEGIS_KNOWLEDGE_RECALL_BUDGET_MS=400
AEGIS_NEO4J_USER=neo4j
AEGIS_NEO4J_PASSWORD=change-me-in-production

# ===== 混合检索（bge-m3 + bge-reranker-v2-m3, ONNX int8 CPU；LLM 不进检索回路）=====
AEGIS_RETRIEVAL_ENABLED=false
# 权重根目录：由仓库根 scripts/fetch_retrieval_models.py 预置，其下 bge-m3-int8/ 与 bge-reranker-v2-m3-int8/
AEGIS_RETRIEVAL_MODEL_DIR=./data/models
# 预算与候选数是一组配套实测值（本机 2026-10-01：重排 5 对中位 4201ms），改一个要重测另一个
AEGIS_RETRIEVAL_BUDGET_MS=5000
# 索引引擎：local（pgvector 密集腿 + 进程内 BM25）| seekdb（两腿都进 seekdb：HNSW 余弦 ANN + ngram 中文全文）
# 选 seekdb 需要 pymysql 驱动：本机形态 `uv sync --extra seekdb`；容器形态 deploy/Dockerfile 已带这个 extra
# （`test_config_env_surface.py` 按部署面判这一点，缺了就是给运维留一个"打开即抛"的开关）。
# 建表与灌数发生在启动期，连不上会记降级而不是拦住建进程
AEGIS_RETRIEVAL_INDEX_BACKEND=local
AEGIS_SEEKDB_HOST=127.0.0.1
AEGIS_SEEKDB_PORT=2881
AEGIS_SEEKDB_USER=root
# 只在驱动里存在：状态面与日志只报 host:port/库/表
AEGIS_SEEKDB_PASSWORD=
AEGIS_SEEKDB_DATABASE=test
AEGIS_SEEKDB_TABLE=aegis_knowledge_doc

# ===== 分析旁路（off | duckdb | clickhouse）=====
# clickhouse 档需要自备实例：deploy/docker-compose.yml 里没有 clickhouse 服务（默认只带 postgres/neo4j/
# redis/mosquitto 等），选它之前先把 host/port/库对上，否则这条腿在 /api/v1/integrations 上读成不可达。
AEGIS_ANALYTICS_BACKEND=off
AEGIS_DUCKDB_PATH=./data/edge_analytics.duckdb

# ===== 链路追踪（用 OTel 官方环境变量名，AEGIS_ 前缀不参与）=====
# 留空＝跨度只记本地、不上报（业务链路不受影响）；起 observability profile 时填采集器入口。
# 可以带凭据（http://user:token@host），日志与 /api/v1/integrations 只显示 host:port/path。
OTEL_ENDPOINT=

POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aegis
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-in-production
MINIO_ROOT_USER=aegis
MINIO_ROOT_PASSWORD=change-me-in-production
# EMQX Dashboard 口令：compose 用 ${VAR:?} 强制要求，缺了 `docker compose up` 直接失败。
EMQX_DASHBOARD_PASSWORD=change-me-in-production
# MQTT 账号（compose 里以 ${VAR:-} 形式引用，留空即匿名）：与 AEGIS_MQTT_USERNAME/PASSWORD 配对
MQTT_USERNAME=
MQTT_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 感知接入 =====
# MQTT 推送腿（站端/边缘网关 publish → 平台 subscribe）。默认关闭：开启需后端镜像装了 [iot] extra。
AEGIS_MQTT_ENABLED=false
AEGIS_MQTT_HOST=127.0.0.1
AEGIS_MQTT_PORT=1883
AEGIS_MQTT_TOPIC_PREFIX=field
AEGIS_MQTT_USERNAME=
AEGIS_MQTT_PASSWORD=
AEGIS_MQTT_QOS=1
# 两轮摄取之间能攒多少条读数；满了丢最旧并计数（不是无界吃内存）
AEGIS_MQTT_BUFFER_LIMIT=5000
# 公开气象/水文接口（拉取腿）：留空则整条腿不出现；形状约定见 backend/src/aegis/connectors/weather_api.py
AEGIS_WEATHER_API_BASE_URL=
AEGIS_WEATHER_API_PATH=/observation
AEGIS_WEATHER_API_TIMEOUT_MS=4000

# ===== 交付通道：mock（演练）| http（对接短信/北斗/广播网关）=====
# http 形态与 workflow 外呼共用同一安全口径：主机白名单为空 = 这条腿没开（构造期报错，绝不静默回落 mock）。
# 凭据只走 AEGIS_DELIVERY_HTTP_TOKEN（进请求头），地址里内嵌凭据会被直接拒绝；状态面里只出现 scheme://host。
AEGIS_DELIVERY_MODE=mock
AEGIS_DELIVERY_HTTP_BASE_URL=
AEGIS_DELIVERY_HTTP_PATH=/publish
AEGIS_DELIVERY_HTTP_CHANNELS=sms,broadcast
AEGIS_DELIVERY_HTTP_ALLOWED_HOSTS=
AEGIS_DELIVERY_HTTP_TIMEOUT_MS=5000
AEGIS_DELIVERY_HTTP_TOKEN=

# ===== 语义交互与人工上报（批次 B/C）=====
# 关掉助手 = 这个出口不存在（/api/v1/assistant/* 直接 404），不是"在但一律 503"。
AEGIS_ASSISTANT_ENABLED=true
# 待确认动作与会话的存活时长（秒）：过期后确认一律不执行
AEGIS_ASSISTANT_SESSION_TTL_SECONDS=1800
# 人工上报解析：等级不是阈值命中所得、或置信低于该值 → human_review_required=true
AEGIS_REPORT_REVIEW_CONFIDENCE=0.6
# 三路融合解析的两条增强腿可单独摘除（做标定对照实验用）；规则腿是唯一判据，不可关
AEGIS_REPORT_LLM_LEG=true
AEGIS_REPORT_EVIDENCE_LEG=true

# ===== 工作流节点外呼（api_call / device_control）=====
# 主机白名单，逗号分隔（可写 host、host:port 或完整 URL，一律按主机粒度匹配）。留空 = 这两类节点不可用。
AEGIS_WORKFLOW_HTTP_ALLOWED_HOSTS=
AEGIS_WORKFLOW_HTTP_TIMEOUT_MS=4000

# ===== MCP 工具面（§4.2 / D4，方案 A）=====
# 关掉 = `/mcp` 这条路径在这个进程里不存在（404）；开着但没装可选依赖 mcp = 路径在、一律 503，
# 且 `/api/v1/integrations` 的 mcp 行读成 driver=absent。这两种"没有工具面"必须能被分辨。
# 开启方式（本机）：`uv sync --extra dev --extra mcp`（uv 的 extras 是整表替换，已有的必须一起列全）；
# 镜像里已含这一 extra。握手 URL 要带尾斜杠：http://127.0.0.1:8000/mcp/
AEGIS_MCP_ENABLED=false
# 挂载路径。改这里只改路径，不改鉴权：工具面与数据 API 共用 AEGIS_SERVICE_TOKEN 同一个面。
AEGIS_MCP_MOUNT_PATH=/mcp
# 暴露面选择器：逗号分隔的工具名，必须是清单里的项（清单见 backend/src/aegis/mcp_tools/manifest.py）。
# 留空 = 用清单的默认面（只读且 default_exposed 的那几项）；写了清单外的名字在装配期就报错，不留空旋钮。
# 默认面含 telemetry.query / retrieval.search / cases.search / memory.search，其中检索腿没装配时
# 那一项进 absent 名单（状态行读得到），不会注册成一个回空表的假工具。
# AEGIS_MCP_TOOLS=telemetry.query,cases.search,memory.search
# 写工具（memory.write）的第二把钥匙：既要在 AEGIS_MCP_TOOLS 里点名，也要这里为 true 才注册。
AEGIS_MCP_ALLOW_WRITE_TOOLS=false
# 真智能体（AEGIS_AGENT_RUNTIME=real）的佐证取数走哪张门面（§4.2 阶段 2）：
#   auto（默认）= 本进程装得出工具面就走 MCP，否则走 REST——不用手动把两处配置对齐；
#   rest         = 永远走 REST 兼容面（灰度回退、与 MCP 做 A/B 对照都留这条）；
#   mcp          = 必须走 MCP，工具面没开/没装就启动失败（不留"配了却没生效"的空旋钮）。
# 现走的哪一张在 `GET /api/v1/integrations` 的 mcp 行 detail.agent_context_face 里读得到。
AEGIS_AGENT_CONTEXT_FACE=auto

# ===== 模拟器与考核指标口径（一般不需改动）=====
AEGIS_SIMULATOR_ENABLED=true
AEGIS_SIMULATOR_INTERVAL_SECONDS=2
AEGIS_SIMULATOR_SEED=20260929
