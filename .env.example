# ===== LLM（OpenAI 兼容接口；留空则研判走规则引擎降级路径）=====
AEGIS_LLM_API_KEY=
AEGIS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AEGIS_LLM_MODEL=qwen-plus
AEGIS_LLM_TIMEOUT_SECONDS=20

# ===== 运行环境 =====
AEGIS_ENV=dev
AEGIS_LOG_LEVEL=INFO
AEGIS_HTTP_HOST=0.0.0.0
AEGIS_HTTP_PORT=8000

# ===== 总线：memory（离线开发）| nats（生产）=====
AEGIS_BUS_BACKEND=memory
AEGIS_NATS_URL=nats://127.0.0.1:4222
AEGIS_NATS_STREAM_PREFIX=AEGIS
AEGIS_DEFAULT_REQUEST_DEADLINE_MS=10000
AEGIS_GATEWAY_ALLOW_UNREGISTERED_ACTION=false

# ===== 存储 =====
AEGIS_DB_URL=sqlite+aiosqlite:///./data/aegis.db
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aegis
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-in-production
MINIO_ROOT_USER=aegis
MINIO_ROOT_PASSWORD=change-me-in-production
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 感知接入 =====
AEGIS_MQTT_HOST=127.0.0.1
AEGIS_MQTT_PORT=1883
AEGIS_MQTT_TOPIC_PREFIX=field
AEGIS_WEATHER_API_BASE_URL=
AEGIS_CONNECTOR_POLL_SECONDS=60

# ===== 交付通道：mock（演练）| http（对接短信/北斗/广播网关）=====
AEGIS_DELIVERY_MODE=mock
AEGIS_DELIVERY_HTTP_BASE_URL=

# ===== 模拟器与考核指标口径（一般不需改动）=====
AEGIS_SIMULATOR_ENABLED=true
AEGIS_SIMULATOR_INTERVAL_SECONDS=2
AEGIS_SIMULATOR_SEED=20260929
